{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "mobbin",
  "version": "1.3.0",
  "description": "Mobbin MCP server and skills for finding real-world app screens, flows, and website sections while designing and building UI.",
  "author": {
    "name": "Mobbin",
    "email": "support@mobbin.com",
    "url": "https://mobbin.com"
  },
  "homepage": "https://docs.mobbin.com/mcp/introduction",
  "repository": "https://github.com/mobbin/skills",
  "license": "MIT",
  "keywords": ["mobbin", "design", "mcp", "ui", "ux"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Mobbin",
        "shortDescription": "Real-world UI references",
        "longDescription": "Where teams and agents find designs that work. Search real app screens, user flows, and website sections on Mobbin while you design and build UI.",
        "developerName": "Mobbin",
        "category": "Design",
        "capabilities": ["Search app screens", "Search user flows", "Search website sections"],
        "websiteURL": "https://mobbin.com",
        "supportURL": "https://help.mobbin.com",
        "privacyPolicyURL": "https://mobbin.com/privacy",
        "termsOfServiceURL": "https://mobbin.com/terms",
        "defaultPrompt": [
          "Find onboarding flows from top fintech apps on Mobbin.",
          "Redesign this settings screen using real apps on Mobbin as reference."
        ],
        "composerIcon": "./.claude-plugin/icon.png",
        "logo": "./.claude-plugin/icon.png"
      }
    }
  }
}
